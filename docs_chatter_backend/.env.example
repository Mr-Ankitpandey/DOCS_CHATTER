ENVIRONMENT=development
PROJECT_NAME="Docs Chatter API"
API_PREFIX=/api
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

DATABASE_URL=postgresql+asyncpg://postgres:your-password@localhost:5432/docs_chatter

OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=docs-chatter
