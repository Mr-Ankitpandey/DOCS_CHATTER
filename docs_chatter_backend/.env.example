ENVIRONMENT=development
PROJECT_NAME="Docs Chatter API"
API_PREFIX=/api
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

DATABASE_URL=postgresql+asyncpg://postgres:your-password@localhost:5432/docs_chatter

OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=docs-chatter

# Required — uploaded documents are stored in Supabase Storage.
# The service role key is admin-level: backend only, never expose it to the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=documents

# Optional — enables the voice query input. Without it the mic returns 503.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
